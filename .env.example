# Copy this file to .env.local. Use only a Supabase publishable/anon key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side OCR for Pharmacy supplier purchase bill scanning (Google Cloud Vision)
# Keep this key in Vercel/server environment only. Never prefix with NEXT_PUBLIC_.
GOOGLE_CLOUD_VISION_API_KEY=

# Anaira Healthcare AI Engine - server-side only; never use NEXT_PUBLIC_ prefix
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Used only as the OCR text fallback before Groq structures the invoice
GOOGLE_CLOUD_VISION_API_KEY=
